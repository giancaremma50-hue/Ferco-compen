# Supabase — Configuración → API en el dashboard del proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca lleva prefijo NEXT_PUBLIC_ ni se importa en un client component.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys. Sin esto el correo falla en
# silencio (notifyBestEffort nunca rompe una mutación por esto).
RESEND_API_KEY=
EMAIL_FROM=

# Opcional — si falta, se deriva del host real de cada request.
NEXT_PUBLIC_SITE_URL=
